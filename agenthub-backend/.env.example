# App
APP_NAME=AgentHub
DEBUG=True

# Terminal logging (see app/core/logging.py). LOG_LEVEL=DEBUG adds agent
# model construction and schema sync; SQL_ECHO=True adds every SQL
# statement, which is a firehose - kept off DEBUG deliberately.
LOG_LEVEL=INFO
SQL_ECHO=False
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Database
# Production / full local stack (needs `docker compose up -d db redis`):
#   DATABASE_URL=postgresql+asyncpg://agenthub:agenthub@localhost:5432/agenthub
# Zero-infra local dev - no Postgres, no Docker (see README):
DATABASE_URL=sqlite+aiosqlite:///./agenthub.db

# Redis
# Production / full local stack:
#   REDIS_URL=redis://localhost:6379/0
# Zero-infra local dev - in-process fakeredis, single worker only:
REDIS_URL=memory://
# ---------------------------------------------------------------------------

# JWT - generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-32-plus-character-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session secret for OAuth state (Authlib/Starlette) - different key from SECRET_KEY
SESSION_SECRET_KEY=change-this-too-different-from-secret-key

# Google OAuth (optional - email/password login works without it)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ---------------------------------------------------------------------------
# LLM - set exactly one of the two keys below and leave LLM_PROVIDER=auto.
# Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
OPENAI_API_KEY=

# auto = use whichever key is set (Google wins if both are). Force one with
# LLM_PROVIDER=google or LLM_PROVIDER=openai.
LLM_PROVIDER=auto
# Blank = provider default (gemini-3.5-flash-lite for Google, gpt-4o for OpenAI)
# Free-tier quota is per model per day and one task costs 3-6 calls, so the
# default is a lite model. gemini-3.6-flash / gemini-3.7-flash are stronger
# but 3.7's free tier allows only 20 requests/day (~4 tasks).
LLM_MODEL=
# ---------------------------------------------------------------------------

# CORS - comma-separated or JSON array, both work
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
